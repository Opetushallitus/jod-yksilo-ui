{
  "name": "@jod/yksilo-ui",
  "version": "0.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "preview": "vite preview",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test",
    "generate:schema": "node ./scripts/generate-schema.js && oxfmt src/api/schema.d.ts --write",
    "prepare": "husky",
    "translations:check": "node ./scripts/translations/analyze-translations.js",
    "translations:fetch": "node ./scripts/translations/fetch-translations.js",
    "translations:push": "tolgee push",
    "translations:tag": "node ./scripts/translations/manage-tags.js",
    "translations:tag:dry": "node ./scripts/translations/manage-tags.js --dry-run"
  },
  "dependencies": {
    "@hookform/error-message": "2.0.1",
    "@hookform/resolvers": "5.9.1",
    "@jod/design-system": "https://github.com/Opetushallitus/jod-design-system/releases/download/rel-20260914-1/jod-design-system-0.0.0.tgz",
    "driver.js": "1.8.0",
    "i18next": "26.4.2",
    "i18next-http-backend": "4.0.2",
    "openapi-fetch": "0.17.0",
    "openapi-typescript-fetch": "2.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-hot-toast": "2.6.0",
    "react-i18next": "17.0.13",
    "react-router": "8.3.1",
    "web-vitals": "6.2.1",
    "zod": "4.5.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/react": "4.13.0",
    "@lavamoat/allow-scripts": "5.1.0",
    "@lavamoat/preinstall-always-fail": "3.0.0",
    "@playwright/test": "1.61.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@tolgee/cli": "2.20.0",
    "@types/node": "24.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.4.1",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "npm:typescript@5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^24.0.0",
    "npm": ">=11.10.0"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false
    }
  }
}
